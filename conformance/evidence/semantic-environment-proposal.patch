+            with self.subTest(value=value):
+                def mutate(w):
+                    state = w["states"][1]["s"]["checked"]
+                    state["environment"][0]["value"] = value
+                    state["snapshots"][2]["bindings"][0]["value"] = value
+                self.rejects(mutate)
