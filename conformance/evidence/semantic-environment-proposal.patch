+                     lambda w: w["states"][1]["#meta"].update(index=0)]
+        for index, mutate in enumerate(mutations):
+            with self.subTest(mutation=index):
+                self.rejects(mutate)
+
+    def test_generic_corruption_or_no_corruption_is_not_this_witness(self):
